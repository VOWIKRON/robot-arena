{
  "name": "robot-arena",
  "version": "0.1.59",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run && node --test tests/check-integration-conflicts.check.mjs tests/next91-resource-artifact-inventory.test.mjs tests/next97-browser-release-gate.test.mjs tests/next101-v02-readiness.test.mjs tests/next92-resource-archive.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "quality": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^5.0.5",
    "@types/node": "^24.0.0"
  }
}
